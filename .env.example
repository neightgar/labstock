# ─── Database ──────────────────────────────────────────────────────────────
# Local development
DATABASE_URL=file:./data/mrb.db
# Docker / production (uncomment)
# DATABASE_URL=file:/app/data/mrb.db

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# ─── Backups ───────────────────────────────────────────────────────────────
BACKUP_DIR=./backups

# ─── Telegram Bot ──────────────────────────────────────────────────────────
# BOT_TOKEN and BOT_ACTIVE are stored in the database (settings table).
# Configure them through the admin panel at /admin — no .env vars needed.
