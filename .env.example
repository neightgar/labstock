# ─── Database ──────────────────────────────────────────────────────────────
# Local development
DATABASE_URL=file:./data/labstock.db
# Docker / production (uncomment)
# DATABASE_URL=file:/app/data/labstock.db

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_SECURE=auto
SESSION_COOKIE_SAMESITE=lax
TRUST_PROXY=true

# ─── Backups ───────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
UPLOAD_DIR=./uploads

# ─── Telegram Bot ──────────────────────────────────────────────────────────
# BOT_TOKEN and BOT_ACTIVE are stored in the database (settings table).
# Configure them through the admin panel at /admin — no .env vars needed.
