<%
  pageTitle = t('auth.profile.title');
  pageSubtitle = '';
  active = '';
  extraScripts = '';
%>
<%- include('../layouts/top', { pageTitle, active, extraScripts }) %>

<% if (success) { %>
  <div class="status-banner" style="margin-bottom:24px"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="status-banner is-error" style="margin-bottom:24px"><%= error %></div>
<% } %>

<form method="POST" action="/profile" class="settings-grid">

  <!-- Account info -->
  <div class="settings-card">
    <div class="settings-card-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </div>
    <h2 class="settings-card-title"><%= t('auth.profile.info') %></h2>
    <div class="form-stack">
      <div class="field">
        <span class="field-label"><%= t('field.username') %></span>
        <input type="text" value="<%= currentUser.username %>" disabled class="field-disabled">
      </div>
      <label class="field">
        <span class="field-label"><%= t('field.displayName') %></span>
        <input type="text" name="displayName" value="<%= currentUser.displayName %>" required>
      </label>
    </div>
  </div>

  <!-- Language -->
  <div class="settings-card">
    <div class="settings-card-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
    </div>
    <h2 class="settings-card-title"><%= t('auth.profile.language') %></h2>
    <div class="filters" style="width:fit-content">
      <% availableLangs.forEach(function(langCode) { %>
        <label class="filter <%= currentUser.language === langCode ? 'is-active' : '' %>" style="cursor:pointer">
          <input type="radio" name="language" value="<%= langCode %>"
                 <%= currentUser.language === langCode ? 'checked' : '' %>
                 style="position:absolute;opacity:0;pointer-events:none">
          <%= t('lang.' + langCode) %>
        </label>
      <% }); %>
    </div>
  </div>

  <!-- Telegram -->
  <div class="settings-card">
    <div class="settings-card-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4 20-7z"/><path d="M22 2 11 13"/></svg>
    </div>
    <h2 class="settings-card-title"><%= t('auth.profile.telegram') %></h2>
    <div class="form-stack">
      <label class="field">
        <span class="field-label"><%= t('field.telegramChatId') %></span>
        <input type="text" name="telegramChatId"
               value="<%= currentUser.telegramChatId || '' %>"
               placeholder="<%= t('placeholder.telegramChatId') %>">
      </label>
    </div>
  </div>

  <!-- Change password -->
  <div class="settings-card">
    <div class="settings-card-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <h2 class="settings-card-title"><%= t('auth.profile.password') %></h2>
    <div class="form-stack">
      <label class="field">
        <span class="field-label"><%= t('field.currentPassword') %></span>
        <input type="password" name="currentPassword" autocomplete="current-password">
      </label>
      <label class="field">
        <span class="field-label"><%= t('field.newPassword') %></span>
        <input type="password" name="newPassword" autocomplete="new-password">
      </label>
    </div>
  </div>

  <div style="display:flex;justify-content:flex-end;padding-bottom:40px">
    <button type="submit" class="btn btn-primary"><%= t('btn.save') %></button>
  </div>

</form>

<!-- API Key -->
<div class="settings-card" style="margin-bottom:40px">
  <div class="settings-card-icon">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
  </div>
  <h2 class="settings-card-title"><%= t('auth.profile.apiKey') %></h2>
  <p class="field-hint" style="margin-bottom:12px"><%= t('auth.profile.apiKeyHint') %></p>

  <% if (newApiKey) { %>
    <div class="status-banner" style="margin-bottom:12px"><%= t('auth.profile.apiKeyOnce') %></div>
    <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px">
      <code id="api-key-value" style="
        background:var(--surface-2,#f5f5f5);
        border:1px solid var(--border,#e0e0e0);
        border-radius:6px;
        padding:8px 12px;
        font-family:var(--font-mono,'JetBrains Mono',monospace);
        font-size:0.85rem;
        word-break:break-all;
        flex:1;
      "><%= newApiKey %></code>
      <button type="button" class="btn btn-secondary" onclick="copyApiKey()" id="copy-btn">
        <%= t('btn.copy') %>
      </button>
    </div>
  <% } else if (currentUser.apiKey) { %>
    <p class="field-hint" style="margin-bottom:12px">
      <%= t('auth.profile.apiKeyExists') %>:
      <code style="font-family:var(--font-mono,'JetBrains Mono',monospace)"><%= currentUser.apiKey.slice(0, 12) %>…</code>
    </p>
  <% } %>

  <form method="POST" action="/profile/api-key" style="display:inline">
    <button type="submit" class="btn btn-secondary"
            onclick="return confirm('<%= t('auth.profile.apiKeyConfirm') %>')">
      <%= currentUser.apiKey ? t('auth.profile.apiKeyRegen') : t('auth.profile.apiKeyGen') %>
    </button>
  </form>
  <a href="/api/v1/docs" target="_blank" class="btn btn-secondary" style="margin-left:8px">
    Swagger UI →
  </a>
</div>

<script>
function copyApiKey() {
  const val = document.getElementById('api-key-value');
  if (!val) return;
  navigator.clipboard.writeText(val.textContent.trim()).then(() => {
    const btn = document.getElementById('copy-btn');
    const orig = btn.textContent;
    btn.textContent = '✓';
    setTimeout(() => { btn.textContent = orig; }, 1500);
  });
}
</script>

<%- include('../layouts/bottom') %>
