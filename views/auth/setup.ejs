<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('auth.setup.title') %> — LabStock</title>
  <link rel="icon" type="image/png" href="/img/labstock.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="auth-body">
<div class="auth-wrap">
  <div class="auth-card">

    <div class="auth-logo">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--accent)">
        <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
      </svg>
    </div>

    <h1 class="auth-title"><%= t('auth.setup.title') %></h1>
    <p class="auth-subtitle"><%= t('auth.setup.subtitle') %></p>

    <% if (error) { %>
      <div class="auth-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/setup" class="auth-form">
      <label class="field">
        <span class="field-label"><%= t('field.username') %></span>
        <input type="text" name="username" autocomplete="username" autofocus required
               placeholder="<%= t('placeholder.username') %>">
      </label>
      <label class="field">
        <span class="field-label"><%= t('field.displayName') %></span>
        <input type="text" name="displayName" autocomplete="name" required
               placeholder="<%= t('placeholder.displayName') %>">
      </label>
      <label class="field">
        <span class="field-label"><%= t('field.password') %></span>
        <input type="password" name="password" autocomplete="new-password" required>
      </label>
      <button type="submit" class="btn btn-primary btn-full"><%= t('auth.setup.btn') %></button>
    </form>

  </div>
</div>
</body>
</html>
