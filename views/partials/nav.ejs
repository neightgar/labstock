<aside class="sidebar" id="main-sidebar">
  <%
    var _brandLabel = 'LabStock';
    if (typeof currentUser !== 'undefined' && currentUser && currentUser.activeWorkspaceId) {
      var _ws = (currentUser.workspaces || []).find(function(w) { return w.id === currentUser.activeWorkspaceId; });
      if (_ws) {
        _brandLabel = currentLang === 'en' ? (_ws.nameEn || _ws.nameRu) : _ws.nameRu;
      }
    }
  %>
  <div class="sidebar-brand">
    <div class="brand-icon">
      <img src="/img/labstock.png" alt="LabStock" width="28" height="28" />
    </div>
    <span class="brand-name"><%= _brandLabel %></span>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class="nav-item <%= active === 'dashboard' ? 'is-active' : '' %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      <span><%= t('nav.dashboard') %></span>
    </a>

    <a href="/reagents" class="nav-item <%= active === 'reagents' ? 'is-active' : '' %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3l-1 6H4l2 4h12l2-4h-3L16 3"/><path d="M6 13v8h12v-8"/><path d="M10 17h4"/></svg>
      <span><%= t('nav.reagents') %></span>
    </a>

    <a href="/consumables" class="nav-item <%= active === 'consumables' ? 'is-active' : '' %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4v1H8V6a4 4 0 0 1 4-4z"/><path d="M8 7v13a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V7"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
      <span><%= t('nav.consumables') %></span>
    </a>

    <a href="/equipment" class="nav-item <%= active === 'equipment' ? 'is-active' : '' %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      <span><%= t('nav.equipment') %></span>
    </a>

    <div class="nav-divider"></div>

    <a href="/orders" class="nav-item <%= active === 'orders' ? 'is-active' : '' %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span><%= t('nav.orders') %></span>
    </a>

    <a href="/protocols" class="nav-item <%= active === 'protocols' ? 'is-active' : '' %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      <span><%= t('nav.protocols') %></span>
    </a>

    <a href="/references" class="nav-item <%= active === 'references' ? 'is-active' : '' %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      <span><%= t('nav.references') %></span>
    </a>

    <% if (currentUser && currentUser.role === 'admin') { %>
      <div class="nav-divider"></div>
      <span class="nav-section-label"><%= t('nav.admin') %></span>
      <a href="/admin" class="nav-item <%= active === 'admin' ? 'is-active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span><%= t('nav.adminPanel') %></span>
      </a>
    <% } %>
  </nav>

  <!-- Language switcher -->
  <div class="lang-switcher">
    <% availableLangs.forEach(function(langCode) { %>
      <a href="/lang/<%= langCode %>"
         class="lang-btn <%= currentLang === langCode ? 'is-active' : '' %>">
        <%= t('lang.' + langCode) %>
      </a>
    <% }); %>
  </div>

  <!-- Logout -->
  <form method="POST" action="/logout" class="logout-form">
    <button type="submit" class="logout-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      <span><%= t('auth.logout') %></span>
    </button>
  </form>
</aside>
