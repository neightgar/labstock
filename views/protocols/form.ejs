<%
  const isEdit = item != null;
  pageTitle    = isEdit ? t('protocols.editTitle') : t('protocols.newTitle');
  active       = 'protocols';
  const action = isEdit ? `/protocols/${item.id}` : '/protocols';
%>
<%- include('../layouts/top', { pageTitle, active }) %>

<link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">

<div style="margin-bottom:16px">
  <a href="<%= isEdit ? '/protocols/' + item.id : '/protocols' %>" class="btn btn-ghost btn-sm">← <%= t('btn.back') %></a>
</div>

<% if (error) { %>
  <div class="status-banner is-error" style="margin-bottom:16px;max-width:900px"><%= error %></div>
<% } %>

<form id="protocol-form" method="post" action="<%= action %>" class="form-card" style="max-width:900px">

  <!-- ── Title fields ──────────────────────────────────── -->
  <p class="form-section-title"><%= t('protocols.section.meta') %></p>

  <div class="field-row">
    <div class="field">
      <label class="field-label"><%= t('protocols.field.titleRu') %> *</label>
      <input type="text" name="titleRu" required
        value="<%= item?.titleRu || '' %>" placeholder="Название на русском">
    </div>
    <div class="field">
      <label class="field-label"><%= t('protocols.field.titleEn') %> *</label>
      <input type="text" name="titleEn" required
        value="<%= item?.titleEn || '' %>" placeholder="Title in English">
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label class="field-label"><%= t('protocols.field.category') %></label>
      <input type="text" name="category" list="cat-list"
        value="<%= item?.category || '' %>" placeholder="<%= t('protocols.field.categoryPlaceholder') %>">
      <datalist id="cat-list">
        <% categories.forEach(function(c) { %><option value="<%= c %>"><% }) %>
      </datalist>
    </div>
    <div class="field">
      <label class="field-label"><%= t('protocols.field.notes') %></label>
      <input type="text" name="notes" value="<%= item?.notes || '' %>"
        placeholder="<%= t('placeholder.notes') %>">
    </div>
  </div>

  <!-- ── Rich-text content ─────────────────────────────── -->
  <p class="form-section-title" style="margin-top:4px"><%= t('protocols.section.content') %></p>

  <!-- Hidden inputs — Quill populates these on submit -->
  <input type="hidden" id="input-content-ru" name="contentRu" value="">
  <input type="hidden" id="input-content-en" name="contentEn" value="">
  <!-- Pass existing HTML to JS without escaping issues -->
  <script type="application/json" id="init-content-ru"><%- JSON.stringify(item?.contentRu || '') %></script>
  <script type="application/json" id="init-content-en"><%- JSON.stringify(item?.contentEn || '') %></script>

  <!-- Tab switcher -->
  <div class="editor-tabs">
    <button type="button" class="editor-tab-btn is-active" data-tab="ru">RU</button>
    <button type="button" class="editor-tab-btn" data-tab="en">EN</button>
  </div>

  <div class="editor-pane" data-pane="ru">
    <div id="editor-ru" class="quill-editor-box"></div>
  </div>
  <div class="editor-pane" data-pane="en" style="display:none">
    <div id="editor-en" class="quill-editor-box"></div>
  </div>

  <!-- ── Materials block ───────────────────────────────── -->
  <p class="form-section-title" style="margin-top:20px"><%= t('protocols.section.materials') %></p>

  <!-- Existing items JSON for JS to read — use enrichedItems (with entity names) if available -->
  <script type="application/json" id="init-items-json"><%- JSON.stringify((typeof enrichedItems !== 'undefined' ? enrichedItems : (item?.items || [])).map(function(it) { return { entityType: it.entityType, entityId: it.entityId, nameRu: it.entity ? it.entity.nameRu : (it.nameRu || ''), nameEn: it.entity ? it.entity.nameEn : (it.nameEn || ''), quantityNeeded: it.quantityNeeded || '', unit: it.unit || '', notes: it.notes || '' }; })) %></script>
  <input type="hidden" id="input-items-json" name="itemsJson" value="[]">

  <!-- Search box -->
  <div class="mat-search-row">
    <input id="mat-search" type="text" class="form-input" style="max-width:320px"
      placeholder="<%= t('protocols.materials.searchPlaceholder') %>">
    <select id="mat-type" class="select-sm">
      <option value="all"><%= t('protocols.materials.typeAll') %></option>
      <option value="reagent"><%= t('protocols.materials.typeReagent') %></option>
      <option value="consumable"><%= t('protocols.materials.typeConsumable') %></option>
      <option value="equipment"><%= t('protocols.materials.typeEquipment') %></option>
    </select>
  </div>
  <div id="mat-results" class="mat-results-dropdown"></div>

  <!-- Added items -->
  <div id="materials-list" class="materials-list"></div>

  <!-- ── Actions ───────────────────────────────────────── -->
  <div class="form-actions" style="margin-top:20px">
    <a href="<%= isEdit ? '/protocols/' + item.id : '/protocols' %>" class="btn btn-ghost"><%= t('btn.cancel') %></a>
    <button type="submit" class="btn btn-primary"><%= t('btn.save') %></button>
  </div>
</form>

<script>
// Pass lang hint to protocol-editor.js
document.documentElement.lang = '<%= currentLang %>';
</script>
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script src="/js/protocol-editor.js"></script>

<%- include('../layouts/bottom') %>
