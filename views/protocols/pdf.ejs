<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= protocol.titleRu %> — v<%= protocol.version %></title>
  <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 11pt;
      color: #1a1a2e;
      background: #fff;
      margin: 0;
      padding: 0;
    }
    .page { max-width: 800px; margin: 0 auto; padding: 24mm 20mm; }

    /* Print toolbar (hidden on print) */
    .print-toolbar {
      position: fixed; top: 0; left: 0; right: 0;
      background: #f8f9fa; border-bottom: 1px solid #dee2e6;
      padding: 10px 20px; display: flex; align-items: center; gap: 12px;
      z-index: 100;
    }
    @media print { .print-toolbar { display: none !important; } }

    /* Offset page content below toolbar in browser */
    @media screen { .page { padding-top: 60px; } }

    /* Header */
    .pdf-header { border-bottom: 2px solid #1a1a2e; padding-bottom: 12px; margin-bottom: 20px; }
    .pdf-title { font-size: 18pt; font-weight: 700; color: #1a1a2e; margin: 0 0 4px; }
    .pdf-subtitle { font-size: 12pt; color: #555; margin: 0 0 8px; }
    .pdf-meta { font-size: 9pt; color: #777; display: flex; gap: 16px; flex-wrap: wrap; }

    /* Category badge */
    .pdf-badge {
      display: inline-block; padding: 2px 8px; border-radius: 3px;
      background: #e9ecef; font-size: 9pt; color: #495057;
    }

    /* Content */
    .section-title { font-size: 12pt; font-weight: 700; color: #1a1a2e; margin: 20px 0 8px; border-bottom: 1px solid #dee2e6; padding-bottom: 4px; }
    .ql-editor { padding: 0; font-size: 11pt; line-height: 1.6; }
    .ql-editor p { margin: 0 0 8px; }
    .ql-editor ul, .ql-editor ol { margin: 0 0 8px; padding-left: 20px; }
    .ql-editor h2 { font-size: 14pt; margin: 12px 0 6px; }
    .ql-editor h3 { font-size: 12pt; margin: 10px 0 5px; }

    /* Materials table */
    table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 10pt; }
    th { background: #f0f0f0; font-weight: 600; padding: 6px 8px; border: 1px solid #dee2e6; text-align: left; }
    td { padding: 5px 8px; border: 1px solid #dee2e6; vertical-align: top; }
    tr:nth-child(even) td { background: #f8f9fa; }

    /* Stock dots */
    .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
    .dot-green  { background: #22c55e; }
    .dot-yellow { background: #f59e0b; }
    .dot-red    { background: #ef4444; }

    /* Notes box */
    .notes-box { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px 12px; font-size: 10pt; color: #555; margin-top: 8px; }

    @page { margin: 20mm; }
    @media print {
      .page { padding: 0; max-width: 100%; }
      a { color: inherit; text-decoration: none; }
    }
  </style>
</head>
<body>

<!-- Print toolbar (screen only) -->
<div class="print-toolbar">
  <button onclick="window.print()" style="padding:6px 14px;background:#1a1a2e;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:0.875rem">
    ⎙ Печать / Print to PDF
  </button>
  <a href="/protocols/<%= protocol.id %>" style="font-size:0.875rem;color:#555;text-decoration:none">← Назад</a>
</div>

<div class="page">
  <!-- Header -->
  <div class="pdf-header">
    <div class="pdf-title"><%= protocol.titleRu %></div>
    <% if (protocol.titleEn && protocol.titleEn !== protocol.titleRu) { %>
      <div class="pdf-subtitle"><%= protocol.titleEn %></div>
    <% } %>
    <div class="pdf-meta">
      <% if (protocol.category) { %><span class="pdf-badge"><%= protocol.category %></span><% } %>
      <span>Версия: v<%= protocol.version %></span>
      <span>Автор: <%= protocol.creator?.displayName || '—' %></span>
      <span>Обновил: <%= protocol.updater?.displayName || '—' %></span>
      <span>Дата: <%= new Date(protocol.updatedAt).toLocaleDateString('ru-RU') %></span>
    </div>
  </div>

  <% if (protocol.notes) { %>
    <div class="notes-box"><%= protocol.notes %></div>
  <% } %>

  <!-- Content RU -->
  <div class="section-title">Содержание</div>
  <div class="ql-snow">
    <div class="ql-editor"><%- protocol.contentRu || '<p>—</p>' %></div>
  </div>

  <!-- Materials -->
  <% if (items.length > 0) { %>
  <div class="section-title">Необходимые материалы</div>
  <table>
    <thead>
      <tr>
        <th style="width:24px"></th>
        <th>Материал</th>
        <th>Тип</th>
        <th>Необходимо</th>
        <th>Остаток</th>
        <th>Примечание</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) {
        let st = 'red';
        if (item.entity) {
          if (item.entityType === 'equipment') {
            st = item.entity.status === 'WORKING' ? 'green' : 'red';
          } else {
            const qty = item.entity.quantity;
            const min = item.entity.minQuantity;
            if (qty > 0 && (min == null || qty > min)) st = 'green';
            else if (qty > 0) st = 'yellow';
          }
        }
        const typeLabelMap = { reagent: 'Реактив', consumable: 'Расходник', equipment: 'Оборудование' };
      %>
      <tr>
        <td style="text-align:center"><span class="dot dot-<%= st %>"></span></td>
        <td>
          <% if (item.entity) { %>
            <%= item.entity.nameRu %>
          <% } else { %>
            <span style="color:#999">ID <%= item.entityId %></span>
          <% } %>
        </td>
        <td><%= typeLabelMap[item.entityType] || item.entityType %></td>
        <td><%= item.quantityNeeded ? (item.quantityNeeded + ' ' + (item.unit || '')) : '—' %></td>
        <td>
          <% if (item.entity && item.entityType !== 'equipment') { %>
            <%= item.entity.quantity %> <%= item.entity.unit || '' %>
          <% } else if (item.entity) { %>
            <%= item.entity.status %>
          <% } else { %>—<% } %>
        </td>
        <td><%= item.notes || '—' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
</body>
</html>
