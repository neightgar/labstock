<%
  pageTitle = protocol.titleRu;
  active    = 'protocols';

  // Stock indicator helper: returns 'green' | 'yellow' | 'red'
  function stockStatus(item) {
    if (!item.entity) return 'red';
    if (item.entityType === 'equipment') {
      return item.entity.status === 'WORKING' ? 'green' : 'red';
    }
    const qty = item.entity.quantity;
    const min = item.entity.minQuantity;
    if (min == null) return qty > 0 ? 'green' : 'red';
    if (qty <= 0)   return 'red';
    if (qty <= min) return 'yellow';
    return 'green';
  }

  function stockTitle(item) {
    if (!item.entity) return t('protocols.stock.notFound');
    if (item.entityType === 'equipment') {
      return item.entity.status === 'WORKING' ? t('protocols.stock.ok') : t('protocols.stock.unavailable');
    }
    const qty = item.entity.quantity;
    const min = item.entity.minQuantity;
    if (qty <= 0) return t('protocols.stock.outOfStock');
    if (min != null && qty <= min) return t('protocols.stock.low') + ': ' + qty + ' ' + (item.entity.unit || '');
    return t('protocols.stock.ok') + ': ' + qty + ' ' + (item.entity.unit || '');
  }

  const lang = currentLang;
%>
<%- include('../layouts/top', { pageTitle, active }) %>

<!-- Header -->
<div class="detail-card">
  <div class="detail-header">
    <div>
      <div class="detail-title"><%= protocol.titleRu %></div>
      <% if (protocol.titleEn && protocol.titleEn !== protocol.titleRu) { %>
        <div class="detail-subtitle"><%= protocol.titleEn %></div>
      <% } %>
      <div style="margin-top:6px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <% if (protocol.category) { %>
          <span class="ref-badge"><%= protocol.category %></span>
        <% } %>
        <span style="font-size:0.8rem;color:var(--text-muted)">v<%= protocol.version %></span>
        <span style="font-size:0.8rem;color:var(--text-muted)">
          <%= t('protocols.updatedBy') %>: <%= protocol.updater?.displayName || '—' %>
          · <%= new Date(protocol.updatedAt).toLocaleDateString('ru-RU') %>
        </span>
      </div>
    </div>
    <div class="detail-actions">
      <a href="/protocols/<%= protocol.id %>/export" target="_blank" class="btn btn-ghost btn-sm">
        ⎙ <%= t('protocols.exportPdf') %>
      </a>
      <a href="/protocols/<%= protocol.id %>/versions" class="btn btn-ghost btn-sm">
        <%= t('protocols.versions') %>
      </a>
      <a href="/protocols/<%= protocol.id %>/edit" class="btn btn-ghost btn-sm"><%= t('btn.edit') %></a>
      <form method="post" action="/protocols/<%= protocol.id %>/delete"
            onsubmit="return confirm('<%= t('confirm.delete') %>')" style="display:inline">
        <button type="submit" class="btn btn-danger btn-sm"><%= t('btn.delete') %></button>
      </form>
    </div>
  </div>

  <% if (protocol.notes) { %>
    <div style="margin-top:12px;padding:10px 14px;background:var(--bg-subtle);border-radius:var(--r-md);font-size:0.875rem;color:var(--text-muted)">
      <%= protocol.notes %>
    </div>
  <% } %>
</div>

<!-- ── Content tabs ───────────────────────────────────── -->
<div class="detail-card" style="margin-top:12px">
  <div class="editor-tabs" style="margin-bottom:12px">
    <button type="button" class="editor-tab-btn is-active" data-tab="ru">RU</button>
    <button type="button" class="editor-tab-btn" data-tab="en">EN</button>
  </div>

  <div class="editor-pane protocol-content ql-snow" data-pane="ru">
    <div class="ql-editor" style="padding:0">
      <%- protocol.contentRu || '<p style="color:var(--text-muted)">—</p>' %>
    </div>
  </div>
  <div class="editor-pane protocol-content ql-snow" data-pane="en" style="display:none">
    <div class="ql-editor" style="padding:0">
      <%- protocol.contentEn || '<p style="color:var(--text-muted)">—</p>' %>
    </div>
  </div>
</div>

<!-- ── Materials ─────────────────────────────────────── -->
<% if (items.length > 0) { %>
<div class="detail-card" style="margin-top:12px">
  <div class="detail-section-title"><%= t('protocols.section.materials') %></div>
  <table class="data-table" style="margin-top:8px">
    <thead>
      <tr>
        <th style="width:28px"></th>
        <th><%= t('protocols.col.material') %></th>
        <th><%= t('protocols.col.matType') %></th>
        <th><%= t('protocols.col.needed') %></th>
        <th><%= t('protocols.col.inStock') %></th>
        <th><%= t('protocols.col.matNotes') %></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) {
        const st = stockStatus(item);
        const entityUrl = item.entityType === 'equipment'
          ? '/equipment/' + item.entityId
          : '/' + item.entityType + 's/' + item.entityId;
      %>
      <tr>
        <td style="text-align:center">
          <span class="stock-dot stock-dot--<%= st %>" title="<%= stockTitle(item) %>"></span>
        </td>
        <td>
          <% if (item.entity) { %>
            <a href="<%= entityUrl %>" class="link-subtle">
              <%= lang === 'ru' ? item.entity.nameRu : (item.entity.nameEn || item.entity.nameRu) %>
            </a>
          <% } else { %>
            <span style="color:var(--text-muted)">ID <%= item.entityId %> (удалено)</span>
          <% } %>
        </td>
        <td>
          <span class="ref-badge">
            <% if (item.entityType === 'reagent') { %><%= t('protocols.materials.typeReagent') %>
            <% } else if (item.entityType === 'consumable') { %><%= t('protocols.materials.typeConsumable') %>
            <% } else { %><%= t('protocols.materials.typeEquipment') %><% } %>
          </span>
        </td>
        <td>
          <% if (item.quantityNeeded) { %>
            <%= item.quantityNeeded %> <%= item.unit || '' %>
          <% } else { %>—<% } %>
        </td>
        <td style="font-size:0.85rem;color:var(--text-muted)">
          <% if (item.entity && item.entityType !== 'equipment') { %>
            <%= item.entity.quantity %> <%= item.entity.unit || '' %>
          <% } else if (item.entity && item.entityType === 'equipment') { %>
            <%= item.entity.status %>
          <% } else { %>—<% } %>
        </td>
        <td style="font-size:0.85rem;color:var(--text-muted)"><%= item.notes || '—' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<!-- ── Attachments ────────────────────────────────────── -->
<div class="attachment-section" style="margin-top:12px">
  <div class="attachment-section-title"><%= t('attachments.title') %></div>

  <% if (attachments.length > 0) { %>
    <div class="attachment-list">
      <% attachments.forEach(function(att) { %>
        <div class="attachment-row">
          <a class="attachment-name" href="/uploads/<%= att.filepath %>" target="_blank"><%= att.filename %></a>
          <span style="font-size:0.75rem;color:var(--text-muted)">
            <%= new Date(att.uploadedAt).toLocaleDateString('ru-RU') %>
          </span>
          <form method="post" action="/protocols/<%= protocol.id %>/attachments/<%= att.id %>/delete"
                onsubmit="return confirm('<%= t('attachments.confirmDelete') %>')" style="display:inline">
            <button type="submit" class="attachment-del"><%= t('btn.delete') %></button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="empty-text" style="text-align:left;padding:0;margin-bottom:14px"><%= t('attachments.empty') %></p>
  <% } %>

  <form method="post" action="/protocols/<%= protocol.id %>/attachments"
        enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center">
    <input type="file" name="file" style="font-size:0.82rem">
    <button type="submit" class="btn btn-ghost btn-sm"><%= t('attachments.upload') %></button>
  </form>
</div>

<div style="margin-top:8px">
  <a href="/protocols" class="btn btn-ghost btn-sm">← <%= t('btn.back') %></a>
</div>

<!-- Tab switcher JS (reuse pattern) -->
<script>
document.querySelectorAll('.editor-tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var target = btn.dataset.tab;
    document.querySelectorAll('.editor-tab-btn').forEach(function(b) {
      b.classList.toggle('is-active', b.dataset.tab === target);
    });
    document.querySelectorAll('.editor-pane').forEach(function(p) {
      p.style.display = p.dataset.pane === target ? '' : 'none';
    });
  });
});
</script>

<link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
<%- include('../layouts/bottom') %>
