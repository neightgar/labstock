<%
  pageTitle = 'v' + snapshot.version + ': ' + snapshot.titleRu;
  active    = 'protocols';
  const lang = currentLang;
%>
<%- include('../layouts/top', { pageTitle, active }) %>

<div style="margin-bottom:16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
  <a href="/protocols/<%= protocol.id %>/versions" class="btn btn-ghost btn-sm">← <%= t('protocols.versions') %></a>
  <span style="font-size:0.85rem;color:var(--text-muted)">
    <%= t('protocols.versionReadOnly') %>
  </span>
</div>

<div class="detail-card">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap">
    <div>
      <div class="detail-title"><%= snapshot.titleRu %></div>
      <% if (snapshot.titleEn && snapshot.titleEn !== snapshot.titleRu) { %>
        <div class="detail-subtitle"><%= snapshot.titleEn %></div>
      <% } %>
      <div style="margin-top:6px;font-size:0.8rem;color:var(--text-muted)">
        v<%= snapshot.version %> · <%= snapshot.changer?.displayName || '—' %>
        · <%= new Date(snapshot.createdAt).toLocaleString('ru-RU') %>
      </div>
    </div>
    <% if (snapshot.version === protocol.version) { %>
      <a href="/protocols/<%= protocol.id %>" class="btn btn-ghost btn-sm">
        <%= t('protocols.currentVersion') %>
      </a>
    <% } %>
  </div>
</div>

<div class="detail-card" style="margin-top:12px">
  <div class="editor-tabs" style="margin-bottom:12px">
    <button type="button" class="editor-tab-btn is-active" data-tab="ru">RU</button>
    <button type="button" class="editor-tab-btn" data-tab="en">EN</button>
  </div>

  <div class="editor-pane protocol-content ql-snow" data-pane="ru">
    <div class="ql-editor" style="padding:0">
      <%- snapshot.contentRu || '<p style="color:var(--text-muted)">—</p>' %>
    </div>
  </div>
  <div class="editor-pane protocol-content ql-snow" data-pane="en" style="display:none">
    <div class="ql-editor" style="padding:0">
      <%- snapshot.contentEn || '<p style="color:var(--text-muted)">—</p>' %>
    </div>
  </div>
</div>

<script>
document.querySelectorAll('.editor-tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var t = btn.dataset.tab;
    document.querySelectorAll('.editor-tab-btn').forEach(function(b) {
      b.classList.toggle('is-active', b.dataset.tab === t);
    });
    document.querySelectorAll('.editor-pane').forEach(function(p) {
      p.style.display = p.dataset.pane === t ? '' : 'none';
    });
  });
});
</script>

<link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
<%- include('../layouts/bottom') %>
