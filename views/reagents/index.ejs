<%
  pageTitle    = t('reagents.title');
  pageSubtitle = t('reagents.subtitle');
  active = 'reagents';

  var showWsCol = currentUser && currentUser.role === 'admin' && !currentUser.activeWorkspaceId;
  function wsColor(id) { return 'ws-c' + ((((id||1)-1)%8)+1); }
  function wsLabel(ws) {
    if (!ws) return '';
    return currentLang === 'en' ? (ws.nameEn || ws.nameRu) : ws.nameRu;
  }

  function qs(overrides) {
    const p = Object.assign({}, query, overrides);
    return Object.entries(p)
      .filter(([,v]) => v !== '' && v != null)
      .map(([k,v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
      .join('&');
  }
%>
<%- include('../layouts/top', { pageTitle, active }) %>

<!-- Import feedback -->
<% if (query.imported) { %>
  <div class="status-banner" style="margin-bottom:14px">
    <%= t('import.success', { count: query.imported }) %>
    <% if (parseInt(query.importErrors) > 0) { %>
      &nbsp;·&nbsp; <%= t('import.errors', { count: query.importErrors }) %>
    <% } %>
  </div>
<% } %>

<!-- Toolbar -->
<div class="page-toolbar">
  <form class="toolbar-filters" method="get" action="/reagents">
    <input class="search-input" type="text" name="search"
      placeholder="<%= t('btn.search') %>"
      value="<%= query.search || '' %>">

    <select class="select-sm" name="locationId">
      <option value=""><%= t('reagents.allLocations') %></option>
      <% locations.forEach(loc => { %>
        <option value="<%= loc.id %>" <%= query.locationId == loc.id ? 'selected' : '' %>>
          <%= currentLang === 'ru' ? loc.nameRu : loc.nameEn %>
        </option>
      <% }) %>
    </select>

    <select class="select-sm" name="manufacturerId">
      <option value=""><%= t('reagents.allManufacturers') %></option>
      <% manufacturers.forEach(m => { %>
        <option value="<%= m.id %>" <%= query.manufacturerId == m.id ? 'selected' : '' %>><%= m.name %></option>
      <% }) %>
    </select>

    <select class="select-sm" name="expiry">
      <option value="">— <%= t('reagents.expiryFilter') %> —</option>
      <option value="soon"    <%= query.expiry === 'soon'    ? 'selected' : '' %>><%= t('reagents.expirySoon') %></option>
      <option value="expired" <%= query.expiry === 'expired' ? 'selected' : '' %>><%= t('reagents.expiryExpired') %></option>
    </select>

    <button type="submit" class="btn btn-ghost btn-sm"><%= t('btn.filter') %></button>
    <% if (query.search || query.locationId || query.manufacturerId || query.expiry) { %>
      <a href="/reagents" class="btn btn-ghost btn-sm"><%= t('btn.reset') %></a>
    <% } %>
  </form>

  <div class="toolbar-actions">
    <a href="/reagents/export?format=xlsx&<%= qs({page:undefined}) %>" class="btn btn-ghost btn-sm">↓ XLSX</a>
    <a href="/reagents/export?format=csv&<%= qs({page:undefined}) %>"  class="btn btn-ghost btn-sm">↓ CSV</a>
    <form method="post" action="/reagents/import" enctype="multipart/form-data" style="display:inline">
      <label class="btn btn-ghost btn-sm" style="cursor:pointer">
        ↑ <%= t('btn.import') %>
        <input type="file" name="file" accept=".xlsx" hidden onchange="this.form.submit()">
      </label>
    </form>
    <a href="/reagents/new" class="btn btn-primary btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <%= t('btn.add') %>
    </a>
  </div>
</div>

<!-- Table -->
<div class="data-table-wrap">
  <% if (items.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3l-1 6H4l2 4h12l2-4h-3L16 3"/><path d="M6 13v8h12v-8"/><path d="M10 17h4"/></svg>
      </div>
      <div class="empty-state-title"><%= t('reagents.empty') %></div>
      <div class="empty-state-sub"></div>
      <% if (!query.search && !query.locationId && !query.manufacturerId && !query.expiry) { %>
        <a href="/reagents/new" class="btn btn-primary btn-sm"><%= t('reagents.addFirst') %></a>
      <% } %>
    </div>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th data-sort="nameRu"><%= t('reagents.col.name') %></th>
        <th data-sort="casNumber"><%= t('reagents.col.cas') %></th>
        <th><%= t('reagents.col.manufacturer') %></th>
        <th data-sort="quantity"><%= t('reagents.col.quantity') %></th>
        <th><%= t('reagents.col.location') %></th>
        <th data-sort="expiryDate"><%= t('reagents.col.expiry') %></th>
        <% if (showWsCol) { %><th><%= t('admin.workspace.col') %></th><% } %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => {
        const now      = new Date();
        const expired  = item.expiryDate && new Date(item.expiryDate) < now;
        const expSoon  = !expired && item.expiryDate && new Date(item.expiryDate) < new Date(Date.now() + 7*86400000);
        const lowStock = item.minQuantity != null && item.quantity <= item.minQuantity;
        const rowClass = expired ? 'row-danger' : (lowStock ? 'row-warn' : '');
      %>
      <tr class="<%= rowClass %>">
        <td>
          <div class="cell-name"><%= item.nameRu %></div>
          <% if (item.nameEn && item.nameEn !== item.nameRu) { %>
            <div class="cell-sub"><%= item.nameEn %></div>
          <% } %>
        </td>
        <td class="cell-mono"><%= item.casNumber || '—' %></td>
        <td><%= item.manufacturer?.name || '—' %></td>
        <td>
          <span class="cell-qty <%= lowStock ? 'cell-qty-low' : '' %>"><%= item.quantity %></span>
          <span class="cell-sub"><%= item.unit %><% if (item.minQuantity != null) { %> / <%= item.minQuantity %><% } %></span>
        </td>
        <td><%= item.location ? (currentLang === 'ru' ? item.location.nameRu : item.location.nameEn) : '—' %></td>
        <td>
          <% if (item.expiryDate) { %>
            <span class="<%= expired ? 'text-danger' : expSoon ? 'text-warn' : '' %>">
              <%= new Date(item.expiryDate).toLocaleDateString(currentLang === 'ru' ? 'ru-RU' : 'en-GB') %>
            </span>
          <% } else { %>—<% } %>
        </td>
        <% if (showWsCol) { %>
        <td><% if (item.workspace) { %><span class="ws-badge <%= wsColor(item.workspace.id) %>"><%= wsLabel(item.workspace) %></span><% } else { %>—<% } %></td>
        <% } %>
        <td>
          <div class="table-actions">
            <button type="button" class="med-action btn-order" title="<%= t('btn.order') %>"
                    data-entity-type="reagent"
                    data-entity-id="<%= item.id %>"
                    data-name-ru="<%= item.nameRu %>"
                    data-name-en="<%= item.nameEn || '' %>"
                    data-manufacturer="<%= item.manufacturer?.name || '' %>"
                    data-catalog-number="<%= item.catalogNumber || '' %>"
                    data-unit="<%= item.unit %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </button>
            <a href="/reagents/<%= item.id %>" class="med-action" title="<%= t('btn.view') %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </a>
            <a href="/reagents/<%= item.id %>/edit" class="med-action" title="<%= t('btn.edit') %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </a>
            <form method="post" action="/reagents/<%= item.id %>/delete"
                  onsubmit="return confirm('<%= t('confirm.delete') %>')" style="display:inline">
              <button type="submit" class="med-action danger" title="<%= t('btn.delete') %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              </button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- Pagination -->
<% if (pages > 1) { %>
<div class="pagination">
  <% if (page > 1) { %>
    <a class="pag-btn" href="/reagents?<%= qs({ page: page - 1 }) %>">←</a>
  <% } else { %>
    <span class="pag-btn is-disabled">←</span>
  <% } %>
  <% for (let p = 1; p <= pages; p++) {
    if (p === 1 || p === pages || Math.abs(p - page) <= 1) { %>
      <a class="pag-btn <%= p === page ? 'is-active' : '' %>" href="/reagents?<%= qs({ page: p }) %>"><%= p %></a>
    <% } else if (Math.abs(p - page) === 2) { %>
      <span class="pag-btn is-disabled">…</span>
    <% }
  } %>
  <% if (page < pages) { %>
    <a class="pag-btn" href="/reagents?<%= qs({ page: page + 1 }) %>">→</a>
  <% } else { %>
    <span class="pag-btn is-disabled">→</span>
  <% } %>
  <span class="pag-info"><%= total %> <%= t('pagination.total') %></span>
</div>
<% } %>

<div style="margin-top:8px">
  <a href="/trash" class="btn btn-ghost btn-sm" style="color:var(--text-muted)">
    🗑 <%= t('trash.link') %>
  </a>
</div>

<%- include('../layouts/bottom') %>
